module downcounter#(
	parameter WIDTH=4
)(                 input wire clk,
		   input  wire rst_n,
		   input wire en,
		   output reg  [WIDTH-1:0]count,
		   output wire overflow
);
assign overflow=en &&(count==0);
always@(posedge clk or negedge rst_n) begin
if (!rst_n)
count<={WIDTH{1'b1}};
else if(en)
       	count<=count-1;
end
endmodule

