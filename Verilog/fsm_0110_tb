module fsm_0110_tb;
reg clk,rst,din;
wire out;
fsm_0110 uut(.clk(clk),
		.rst(rst),
		.din(din),
		.out(out)
);
always #10 clk=~clk;
initial begin
$dumpfile("fsm_0110_tb.vcd");
$dumpvars(0,fsm_0110_tb);
$monitor("clk=%b rst=%b din=%b out=%b",clk,rst,din,out);
clk=0;
rst=0;
din=0;
rst=1;#25;
rst=0;#10;
din=0;#10;
din=1;#10;
din=1;#10;
din=0;#10;
$finish;
end
endmodule 


