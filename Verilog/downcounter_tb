module downcounter_tb;
reg clk;
reg rst_n;
reg en;
wire [3:0]counter;
wire overflow;
downcounter uut(.clk(clk),
		 .rst_n(rst_n),
		 .en(en),
		 .count(counter),
		 .overflow(overflow)
);
initial clk=0;
always #5 clk=~clk;
initial begin 
$dumpfile("downcounter_tb.vcd");
$dumpvars(0,downcounter_tb);
$monitor("clk=%b rst_n=%b en=%b counter=%b overflow=%b",clk,rst_n,en,counter,overflow);
        rst_n = 0; en = 0;
        @(posedge clk); #1;
        @(posedge clk); #1;
        rst_n = 1; en = 1;
        repeat(20) @(posedge clk);
        en = 0;
        repeat(4) @(posedge clk);
        en = 1;
        repeat(4) @(posedge clk);
       
       	rst_n = 0;
        @(posedge clk); #1;
       	rst_n = 1;
        repeat(5) @(posedge clk);

        
        $finish;
    end

endmodule
