module SR_ff_tb;
reg clk;
reg rst_n;
reg S,R;
wire q;
wire q_bar;
SR_ff uut (.clk(clk),
		.rst_n(rst_n),
		.S(S),
		.R(R),
		.q(q),
		.q_bar(q_bar)
);
always #5 clk=~clk;
initial begin
clk=0;
rst_n=0;
S=0;
R=0;
$dumpfile("SR_ff_tb.vcd");
$dumpvars(0,SR_ff_tb);
$monitor("clk=%b rst_n=%b S=%b R=%b q=%b q_bar=%b",clk,rst_n,S,R,q,q_bar);
#10;
rst_n=1;
S=0;#10;
R=0;#10;

S=0;#10;
R=1;#10;

S=1;#10;
R=0;#10;

S=1;#10;
R=1;#10;

rst_n=1;
#10;

$finish;
end
endmodule
