module T_ff_tb;
reg clk;
reg rst_n;
reg T;
wire q;
wire q_bar;
T_ff uut (.clk(clk),
		.rst_n(rst_n),
		.T(T),
		.q(q),
		.q_bar(q_bar)
);
always #5 clk=~clk;
initial begin
clk=0;
rst_n=0;
T=0;
$dumpfile("T_ff_tb.vcd");
$dumpvars(0,T_ff_tb);
$monitor("clk=%b rst_n=%b T=%b q=%b q_bar=%b",clk,rst_n,T,q,q_bar);
#10;
rst_n=1;
T=1;#10;
T=0;
#10;
T=1;
#10;
rst_n=0;
#10;
rst_n=1;
#10;
T=0;
$finish;
end
endmodule
