module JK_ff_tb;
reg clk;
reg rst_n;
reg J,K;
wire q;
wire q_bar;
JK_ff uut (.clk(clk),
		.rst_n(rst_n),
		.J(J),
		.K(K),
		.q(q),
		.q_bar(q_bar)
);
always #5 clk=~clk;
initial begin
clk=0;
rst_n=0;
J=0;
K=0;
$dumpfile("JK_ff_tb.vcd");
$dumpvars(0,JK_ff_tb);
$monitor("clk=%b rst_n=%b J=%b K=%b q=%b q_bar=%b",clk,rst_n,J,K,q,q_bar);
#10;
rst_n=1;
J=0;#10;
K=0;#10;

J=0;#10;
K=1;#10;

J=1;#10;
K=0;#10;

J=1;#10;
K=1;#10;

rst_n=1;
#10;

$finish;
end
endmodule
