module D_ff_as_tb;
reg clk;
reg rst_n;
reg d;
wire q;
wire q_bar;
D_ff_as uut (.clk(clk),
		.rst_n(rst_n),
		.d(d),
		.q(q),
		.q_bar(q_bar)
);
always #5 clk=~clk;
initial begin
clk=0;
rst_n=0;
d=0;
$dumpfile("D_ff_as_tb.vcd");
$dumpvars(0,D_ff_as_tb);
$monitor("clk=%b rst_n=%b d=%b q=%b q_bar=%b",clk,rst_n,d,q,q_bar);
#10;
rst_n=1;
d=1;#10;
d=0;
#10;
d=1;
#10;
rst_n=0;
#10;
rst_n=1;
#10;
d=0;
$finish;
end
endmodule
