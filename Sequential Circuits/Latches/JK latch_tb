module tb_jk_latch;
    reg J, K, EN;
    wire Q;

    jk_latch uut (.J(J), .K(K), .EN(EN), .Q(Q));

    initial begin
        $dumpfile("jk_latch.vcd");
        $dumpvars(0, tb_jk_latch);

        $monitor("EN=%b J=%b K=%b Q=%b", EN, J, K, Q);

        EN=1; J=0; K=0; #10;
        EN=1; J=1; K=0; #10;
        EN=1; J=0; K=1; #10;
        EN=1; J=1; K=1; #10;

        $finish;
    end
endmodule
