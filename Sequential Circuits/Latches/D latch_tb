module tb_d_latch;
    reg D, EN;
    wire Q;
 d_latch uut (.D(D), .EN(EN), .Q(Q));
initial begin
        $dumpfile("d_latch.vcd");
        $dumpvars(0, tb_d_latch);
        $monitor("EN=%b D=%b Q=%b", EN, D, Q);
        EN=0; D=0; #10;
        EN=1; D=1; #10;
        EN=1; D=0; #10;
        EN=0; D=1; #10;

        $finish;
    end
endmodule
